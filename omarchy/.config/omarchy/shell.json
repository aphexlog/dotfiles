{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "aphexlog.clock",
    "layout": {
      "left": [
        {
          "id": "aphexlog.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "aphexlog.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "right": [
        {
          "id": "aphexlog.usage"
        },
        {
          "id": "dqckey.ytmusic-player"
        },
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.wesleycole.google-drive"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "id": "aphexlog.bar"
  },
  "plugins": [
    {
      "id": "aphexlog.monitor-wallpaper"
    },
    {
      "id": "aphexlog.lock"
    },
    {
      "id": "aphexlog.idle"
    },
    {
      "id": "aphexlog.notifications"
    }
  ],
  "disabledPlugins": [
    "omarchy.lock",
    "omarchy.idle",
    "omarchy.notifications",
    "omarchy.menu"
  ],
  "cloneSourceRestores": [
    "aphexlog.lock",
    "aphexlog.idle",
    "aphexlog.notifications",
    "aphexlog.menu"
  ]
}
