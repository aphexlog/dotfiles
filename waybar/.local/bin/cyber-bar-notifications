#!/usr/bin/env python3
"""Read the shell's existing notification history without replaying toasts."""
import json
from pathlib import Path

directory = Path.home() / ".local/state/omarchy/notifications/history"
entries = []
for path in sorted(directory.glob("*.json"), reverse=True)[:20]:
    try:
        row = json.loads(path.read_text())
        if isinstance(row, dict):
            entries.append(row)
    except (OSError, ValueError):
        continue
print(json.dumps(entries))
