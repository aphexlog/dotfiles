{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "neon-mocha",
    "mode": "dark"
  },
  "cursor": {
    "style": "default"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "show",
    "grouping": "none",
    "verbosity": "high"
  },
  "plugins": [
    "./plugins/activity-sidebar"
  ],
  "animations": false
}
