{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": ["purple", "blue", "green", "cyan", "red", "yellow"],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$hovered": "$hue.purple.100",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200",
          "$disabled": "$text.muted"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$selected": "$text.base",
        "$disabled": "$text.muted"
      },
      "feedback": {
        "error": { "base": "$hue.red.200" },
        "warning": { "base": "$hue.yellow.200" },
        "success": { "base": "$hue.green.200" },
        "info": { "base": "$hue.cyan.200" }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent",
          "$hovered": "$background.raised.base"
        },
        "destructive": { "base": "$hue.red.200" }
      },
      "formfield": { "base": "$background.base" },
      "feedback": {
        "error": { "base": "$background.base" },
        "warning": { "base": "$background.base" },
        "success": { "base": "$background.base" },
        "info": { "base": "$background.base" }
      }
    },
    "border": { "base": "#2b3654" },
    "scrollbar": { "base": "$hue.neutral.500" },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "$hue.red.200",
        "context": "$text.muted",
        "hunkHeader": "$hue.purple.200"
      },
      "background": {
        "added": "$hue.green.800",
        "removed": "$hue.red.800",
        "context": "$background.base"
      },
      "highlight": {
        "added": "$hue.green.100",
        "removed": "$hue.red.100"
      },
      "lineNumber": {
        "text": "$text.muted",
        "background": {
          "added": "$hue.green.900",
          "removed": "$hue.red.900"
        }
      }
    },
    "syntax": {
      "comment": "$hue.neutral.400",
      "keyword": "$hue.purple.200",
      "function": "$hue.blue.200",
      "variable": "$hue.neutral.200",
      "string": "$hue.green.200",
      "number": "$hue.yellow.200",
      "type": "$hue.cyan.200",
      "operator": "$hue.purple.200",
      "punctuation": "$hue.neutral.300"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.purple.200",
      "link": "$hue.blue.200",
      "linkText": "$hue.cyan.200",
      "code": "$hue.green.200",
      "blockQuote": "$hue.neutral.300",
      "emphasis": "$hue.purple.200",
      "strong": "$hue.blue.100",
      "horizontalRule": "$hue.neutral.500",
      "listItem": "$hue.green.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.blue.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": { "$hovered": "$background.raised.high" }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#eef4ff",
        "200": "#c8d6f4",
        "300": "#a1b1d2",
        "400": "#7b8bad",
        "500": "#34305a",
        "600": "#1b243b",
        "700": "#141b30",
        "800": "#0b1020",
        "900": "#070b16"
      },
      "red": {
        "100": "#ff9db3",
        "200": "#ff7b98",
        "300": "#d96885",
        "400": "#b45a72",
        "500": "#8f4b60",
        "600": "#6c3b4f",
        "700": "#4c2d3e",
        "800": "#2d1c30",
        "900": "#1e1423"
      },
      "orange": {
        "100": "#ffd4b3",
        "200": "#f3b58b",
        "300": "#d49c7c",
        "400": "#b2826b",
        "500": "#906b5b",
        "600": "#705348",
        "700": "#513e39",
        "800": "#332928",
        "900": "#201b20"
      },
      "yellow": {
        "100": "#f5e2aa",
        "200": "#e7cf8b",
        "300": "#c6b278",
        "400": "#a79667",
        "500": "#887b57",
        "600": "#695f46",
        "700": "#4d4737",
        "800": "#313026",
        "900": "#1e201d"
      },
      "green": {
        "100": "#92f5cc",
        "200": "#65e6b4",
        "300": "#55c49c",
        "400": "#48a486",
        "500": "#3c846e",
        "600": "#306657",
        "700": "#234940",
        "800": "#102a2b",
        "900": "#0c1d22"
      },
      "cyan": {
        "100": "#96edff",
        "200": "#68d9ef",
        "300": "#58bacf",
        "400": "#4b9bb0",
        "500": "#3d7e90",
        "600": "#306271",
        "700": "#244754",
        "800": "#172e3a",
        "900": "#0e1e2a"
      },
      "blue": {
        "100": "#9bc4ff",
        "200": "#6ea8ff",
        "300": "#5e90df",
        "400": "#5078be",
        "500": "#41629e",
        "600": "#334d7e",
        "700": "#26395f",
        "800": "#192642",
        "900": "#111a2e"
      },
      "purple": {
        "100": "#d1b5ff",
        "200": "#b794ff",
        "300": "#9e7fdf",
        "400": "#856cbe",
        "500": "#6d599e",
        "600": "#56477e",
        "700": "#40355f",
        "800": "#2b2442",
        "900": "#1c192e"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray"
    }
  }
}
