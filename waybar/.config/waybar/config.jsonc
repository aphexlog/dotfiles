// ==============================================================================
// Per-Monitor Bar Placement
// ==============================================================================
// Match the display identity so DisplayPort connector renumbering is harmless.
[
  {
    "output": ["!LG Electronics LG HDR 4K 0x0005CD72", "*"],
    "position": "top",
    // Show only the left monitor's workspace buttons.
    "group/workspaces": {
      "orientation": "horizontal",
      "modules": ["custom/workspace1", "custom/workspace2", "custom/workspace3", "custom/workspace4", "custom/workspace5"]
    },
    "include": ["~/.config/waybar/common.jsonc"]
  },
  {
    "output": "LG Electronics LG HDR 4K 0x0005CD72",
    "position": "bottom",
    "margin-top": 0,
    "margin-bottom": 4,
    // Show only the right monitor's workspace buttons (10 is labeled 0).
    "group/workspaces": {
      "orientation": "horizontal",
      "modules": ["custom/workspace6", "custom/workspace7", "custom/workspace8", "custom/workspace9", "custom/workspace10"]
    },
    "include": ["~/.config/waybar/common.jsonc"]
  }
]
