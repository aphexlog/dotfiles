[Unit]
Description=Local Qwen3.8 Flash Next model server for OpenCode
Documentation=https://github.com/ggml-org/llama.cpp
StartLimitIntervalSec=300
StartLimitBurst=2

[Service]
Type=simple
WorkingDirectory=%h/.local/share/local-llm
ExecStart=%h/.local/share/local-llm/start-server
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
UMask=0077

# Keep inference from exhausting desktop RAM or spilling model state into swap.
MemoryHigh=70G
MemoryMax=80G
MemorySwapMax=0
OOMPolicy=stop

[Install]
WantedBy=default.target
