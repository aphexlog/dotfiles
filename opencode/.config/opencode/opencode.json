{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": false,
  "instructions": [
    "~/.config/opencode/instructions/commit-style.md",
    "~/.config/opencode/instructions/pr-style.md",
    "~/.config/opencode/instructions/aws.md",
    "~/.config/opencode/instructions/local-models.md"
  ],
  "providers": {
    "local": {
      "name": "Local Radeon 890M",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "headerTimeout": 1800000,
        "chunkTimeout": 300000
      },
      "models": {
        "qwen3.8-flash-next-abliterated": {
          "modelID": "qwen3.8-flash-next-abliterated",
          "name": "Qwen3.8 Flash Next Abliterated (local)",
          "family": "qwen3.8",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "compatibility": {
            "reasoningField": "reasoning_content"
          },
          "limit": {
            "context": 65536,
            "output": 8192
          },
          "cost": {
            "input": 0,
            "output": 0
          },
          "body": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20,
            "min_p": 0,
            "chat_template_kwargs": {
              "enable_thinking": true,
              "reasoning_effort": "medium",
              "preserve_thinking": true
            }
          },
          "variants": [
            {
              "id": "fast",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": false
                }
              }
            },
            {
              "id": "deep",
              "body": {
                "chat_template_kwargs": {
                  "enable_thinking": true,
                  "reasoning_effort": "xhigh"
                }
              }
            }
          ]
        }
      }
    }
  }
}
