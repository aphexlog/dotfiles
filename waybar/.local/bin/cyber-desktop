#!/usr/bin/env python3
"""Shared desktop controls for the bar and OpenCode. JSON in, JSON out."""

import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time


##############################################################################
# Compositor State and Validated Targets
##############################################################################

HOME = Path.home()
SCALES = (1, 1.25, 1.5, 1.6, 1.75, 2)
OVERRIDE_HEADER = "-- Generated by cyber-desktop; saved display controls.\n"


def run(*command):
    result = subprocess.run(command, capture_output=True, text=True, timeout=12)
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or result.stdout.strip() or "Command failed")
    return result.stdout.strip()


def query(name):
    return json.loads(run("hyprctl", name, "-j"))


def lua(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    return json.dumps(value, ensure_ascii=False)


def dispatch(name, **options):
    expression = "hl.dsp." + name + "({ " + ", ".join(
        key + " = " + lua(value) for key, value in options.items()
    ) + " })"
    output = run("hyprctl", "dispatch", expression)
    if output != "ok":
        raise RuntimeError(output)


def integer(value, low, high):
    if isinstance(value, bool) or not isinstance(value, int) or not low <= value <= high:
        raise ValueError(f"Expected an integer between {low} and {high}")
    return value


def monitor_target(name):
    monitors = sorted(query("monitors"), key=lambda m: (m["x"], m["y"]))
    if not monitors:
        raise ValueError("No connected monitors")
    if name == "left":
        return monitors[0]
    if name == "right":
        return monitors[-1]
    for monitor in monitors:
        if (name == "current" and monitor["focused"]) or name in (monitor["name"], monitor["description"]):
            return monitor
    raise ValueError("Monitor is not connected; inspect desktop state first")


def window_target(address):
    if not address or address == "active":
        address = query("activewindow").get("address", "")
    if not re.fullmatch(r"0x[0-9a-fA-F]+", address):
        raise ValueError("Select an open window first")
    for window in query("clients"):
        if window["address"] == address and window.get("mapped", True):
            return window
    raise ValueError("That window is no longer open")


def status():
    monitors = sorted(query("monitors"), key=lambda m: (m["x"], m["y"]))
    windows = sorted(query("clients"), key=lambda w: w.get("focusHistoryID", 9999))
    return {
        "ok": True,
        "monitors": [{key: monitor[key] for key in (
            "name", "description", "x", "y", "width", "height", "scale",
            "transform", "focused", "activeWorkspace",
        )} for monitor in monitors],
        "workspaces": [{key: workspace[key] for key in ("id", "monitor", "windows")}
                       for workspace in query("workspaces") if workspace["id"] > 0],
        "windows": [{key: window[key] for key in (
            "address", "class", "title", "workspace", "monitor", "floating", "fullscreen", "at", "size",
        )} for window in windows if window.get("mapped", True)],
        "activeWindow": query("activewindow").get("address", ""),
        "scales": SCALES,
        "configErrors": run("hyprctl", "configerrors"),
    }


##############################################################################
# Persistent Display Controls
##############################################################################

def display_rules(monitors, previous=None):
    # Keep saved rules for unplugged displays, replacing only the selected one.
    rules = {}
    if previous is not None:
        if not previous.startswith(OVERRIDE_HEADER):
            raise ValueError("desktop-controls.lua contains custom configuration; refusing to overwrite it")
        for line in previous[len(OVERRIDE_HEADER):].splitlines():
            if not line.strip():
                continue
            match = re.fullmatch(r'hl\.monitor\(\{ output = ("(?:[^"\\]|\\.)*"), .+ \}\)', line)
            if not match:
                raise ValueError("desktop-controls.lua contains an unrecognized display rule")
            rules[json.loads(match[1])] = line
    for monitor in monitors:
        fields = {
            "output": "desc:" + monitor["description"],
            "mode": f"{monitor['width']}x{monitor['height']}@{monitor['refreshRate']}",
            "position": f"{monitor['x']}x{monitor['y']}",
            "scale": monitor["scale"],
            "transform": monitor["transform"],
        }
        rules[fields["output"]] = "hl.monitor({ " + ", ".join(
            key + " = " + lua(value) for key, value in fields.items()
        ) + " })"
    return OVERRIDE_HEADER + "\n".join(rules.values()) + "\n"


def write_rules(path, content):
    with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, suffix=".lua", delete=False) as handle:
        temporary = Path(handle.name)
        handle.write(content)
    try:
        run("luac", "-p", str(temporary))
        os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def verify_display(expected):
    # Config reload returns before the output has necessarily been reconfigured.
    for _ in range(20):
        actual = monitor_target(expected["description"])
        if all(actual[key] == expected[key] for key in ("x", "y", "transform", "width", "height")) \
                and abs(actual["scale"] - expected["scale"]) < 0.001:
            return
        time.sleep(0.05)
    raise RuntimeError("The compositor did not apply the requested display geometry and scale")


def set_scale(name, value):
    if isinstance(value, bool) or value not in SCALES:
        raise ValueError("Choose a supported scale: " + ", ".join(map(str, SCALES)))
    selected = monitor_target(name)
    if any(abs(size / value - round(size / value)) > 0.001 for size in (selected["width"], selected["height"])):
        raise ValueError("This scale does not fit the monitor's pixel dimensions")
    path = HOME / ".config/hypr/desktop-controls.lua"
    previous = path.read_text() if path.exists() else None
    updated = {**selected, "scale": value}
    content = display_rules([updated], previous)
    if run("hyprctl", "configerrors"):
        raise RuntimeError("Resolve the existing Hyprland configuration errors before saving display changes")
    write_rules(path, content)
    try:
        run("hyprctl", "reload")
        errors = run("hyprctl", "configerrors")
        if errors:
            raise RuntimeError(errors)
        verify_display(updated)
    except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as error:
        try:
            if previous is None:
                path.unlink()
            else:
                write_rules(path, previous)
            run("hyprctl", "reload")
            errors = run("hyprctl", "configerrors")
            if errors:
                raise RuntimeError(errors)
            verify_display(selected)
        except (ValueError, RuntimeError, OSError, subprocess.SubprocessError) as rollback:
            raise RuntimeError(f"Display change failed: {error}; rollback could not be verified: {rollback}") from error
        raise RuntimeError(f"Display change was rolled back: {error}") from error


##############################################################################
# Desktop Actions
##############################################################################

def control(request):
    action = request.get("action")
    if action == "status":
        return status()
    if action == "focus_workspace":
        dispatch("focus", workspace=str(integer(request.get("workspace"), 1, 10)))
    elif action == "focus_monitor":
        dispatch("focus", monitor=monitor_target(request.get("monitor", "current"))["name"])
    elif action in ("focus_window", "move_window", "float_window", "tile_window", "fullscreen_window",
                    "maximize_window", "center_window", "resize_window", "close_window"):
        window = window_target(request.get("window"))
        target = "address:" + window["address"]
        if action == "focus_window":
            dispatch("focus", window=target)
        elif action == "move_window":
            workspace = request.get("workspace")
            if workspace is None:
                workspace = monitor_target(request.get("monitor", "current"))["activeWorkspace"]["id"]
            follow = request.get("follow", False)
            if not isinstance(follow, bool):
                raise ValueError("follow must be true or false")
            dispatch("window.move", window=target, workspace=str(integer(workspace, 1, 10)), follow=follow)
        elif action in ("float_window", "tile_window"):
            dispatch("window.float", window=target, action="on" if action == "float_window" else "off")
        elif action in ("fullscreen_window", "maximize_window"):
            dispatch("window.fullscreen", window=target,
                     mode="fullscreen" if action == "fullscreen_window" else "maximized", action="toggle")
        elif action == "center_window":
            dispatch("window.float", window=target, action="on")
            dispatch("window.center", window=target)
        elif action == "resize_window":
            x = integer(request.get("x", 0), -1000, 1000)
            y = integer(request.get("y", 0), -1000, 1000)
            dispatch("window.resize", window=target, x=x, y=y, relative=True)
        else:
            dispatch("window.close", window=target)
    elif action == "monitor_scale":
        set_scale(request.get("monitor", "current"), request.get("value"))
    elif action == "volume":
        value = integer(request.get("value"), 0, 100)
        run("pactl", "set-sink-volume", "@DEFAULT_SINK@", str(value) + "%")
    elif action == "mute":
        run("pactl", "set-sink-mute", "@DEFAULT_SINK@", "toggle")
    elif action == "microphone_mute":
        run("pactl", "set-source-mute", "@DEFAULT_SOURCE@", "toggle")
    elif action == "toggle":
        setting = request.get("setting")
        if setting not in ("nightlight", "idle"):
            raise ValueError("Toggle setting must be nightlight or idle")
        run("omarchy", "toggle", setting)
    elif action == "settings":
        setting = request.get("setting")
        panels = {"audio": "aphexlog.audio", "network": "aphexlog.network",
                  "bluetooth": "aphexlog.bluetooth", "controls": "aphexlog.controls"}
        if setting in panels:
            run("omarchy-shell", "shell", "summon", panels[setting])
        elif setting in ("theme", "keybindings", "root"):
            run("omarchy-shell", "shell", "summon", "aphexlog.menu",
                json.dumps({"initialMenu": {"theme": "appearance.theme", "keybindings": "learn.keybindings",
                                           "root": "root"}[setting]}))
        elif setting == "wallpaper":
            subprocess.Popen([str(HOME / ".local/bin/wallpaper-monitor-pick")],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        else:
            raise ValueError("Unknown settings panel")
    else:
        raise ValueError("Unknown desktop action")
    return {"ok": True, "action": action}


def main():
    try:
        request = {"action": "status"} if len(sys.argv) < 2 or sys.argv[1] == "status" else json.loads(sys.argv[1])
        if not isinstance(request, dict):
            raise ValueError("Expected a JSON object")
        print(json.dumps(control(request), ensure_ascii=False))
    except (ValueError, KeyError, RuntimeError, OSError, subprocess.SubprocessError) as error:
        print(json.dumps({"ok": False, "error": str(error)}, ensure_ascii=False))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
