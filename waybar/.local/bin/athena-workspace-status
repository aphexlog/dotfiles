#!/bin/bash
set -euo pipefail

##############################################################################
# Per-Monitor Workspace Indicator
##############################################################################

# Highlight the visible desktop on each monitor; label workspace 10 as key 0.
workspace="${1:?workspace number required}"
hyprctl monitors -j | jq -c --argjson id "$workspace" '
  {text: (if $id == 10 then "0" else ($id | tostring) end),
   tooltip: ((if $id <= 5 then "Left" else "Right" end) + " monitor · Desktop " + ($id | tostring)),
   class: (if any(.[]; .activeWorkspace.id == $id) then "active" else "inactive" end)}
'
