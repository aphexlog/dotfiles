@OBSThemeMeta {
    name: 'PhxCast Cyberpunk';
    id: 'com.phxcast.Yami.Cyberpunk';
    extends: 'com.obsproject.Yami';
    author: 'PhxCast';
    dark: 'true';
}

/* ========================================================================== */
/* Palette: midnight circuitry, electric cyan, and neon magenta                */
/* ========================================================================== */

@OBSThemeVars {
    --cyber_cyan: #00E5FF;
    --cyber_ice: #91F7FF;
    --cyber_magenta: #FF3BAD;
    --cyber_pink: #FF9BD5;
    --cyber_violet: #A58AFF;
    --cyber_line: #24465B;

    --grey1: #526F89;
    --grey2: #344D65;
    --grey3: #213C52;
    --grey4: #192C40;
    --grey5: #122033;
    --grey6: #0D1726;
    --grey7: #090F1B;
    --grey8: #050912;

    --white1: #E5F4FF;
    --white2: #D1E8F5;
    --white3: #BAD6E7;
    --white4: #9BB7CC;
    --white5: #829BB2;

    --blue1: #91F7FF;
    --blue2: #00CDE8;
    --blue3: #16627A;
    --blue4: #124A60;
    --blue5: #10374A;
    --blue6: #0B2636;

    --pink1: #FF9BD5;
    --pink2: #FF3BAD;
    --pink3: #B72B7D;
    --pink4: #85245F;
    --pink5: #53203F;
    --pink6: #301629;

    --purple1: #C4AEFF;
    --purple2: #A58AFF;
    --purple3: #795BD1;
    --purple4: #574296;
    --purple5: #392C65;
    --purple6: #241F42;

    --green1: #A4FFD4;
    --green2: #41E9A4;
    --green3: #259E76;
    --green4: #1B7156;
    --green5: #124D3F;
    --green6: #0B302B;

    --yellow1: #FFE3A1;
    --yellow2: #F6C760;
    --yellow3: #C99737;
    --yellow4: #906A2C;
    --yellow5: #584326;
    --yellow6: #33291D;

    --red1: #FF9BAE;
    --red2: #FF5277;
    --red3: #C92B51;
    --red4: #99233E;
    --red5: #641C31;
    --red6: #391523;

    --bg_window: var(--grey7);
    --bg_base: var(--grey6);
    --bg_preview: var(--grey8);

    --primary: var(--blue3);
    --primary_light: #217B94;
    --primary_lighter: var(--cyber_cyan);
    --primary_dark: var(--blue4);
    --primary_darker: var(--blue5);
    --highlight_color: var(--cyber_cyan);
    --separator_hover: var(--cyber_magenta);

    --text: var(--white1);
    --text_light: var(--white1);
    --text_muted: var(--white5);
    --text_disabled: #60768F;
    --text_inactive: var(--white3);
    --warning: var(--yellow2);
    --danger: var(--red2);

    --border_color: var(--cyber_line);
    --border_radius: 3px;
    --border_radius_small: 1px;
    --border_radius_large: 4px;

    --input_bg: var(--grey5);
    --input_bg_hover: var(--grey4);
    --input_bg_focus: var(--grey8);
    --input_border: var(--cyber_line);
    --input_border_hover: #3D7B94;
    --input_border_focus: var(--cyber_cyan);

    --list_item_bg_selected: #154459;
    --list_item_bg_hover: #162D42;

    --button_bg: #12283B;
    --button_bg_hover: #1A4054;
    --button_bg_down: #091C2B;
    --button_bg_disabled: var(--grey6);
    --button_border: #2B536D;
    --button_border_hover: var(--cyber_cyan);
    --button_border_focus: var(--cyber_cyan);

    --tab_bg: var(--grey6);
    --tab_bg_hover: var(--grey4);
    --tab_bg_down: #153448;
    --tab_border: var(--cyber_line);
    --tab_border_hover: var(--cyber_cyan);
    --tab_border_focus: var(--cyber_cyan);
    --tab_border_selected: var(--cyber_magenta);

    --scrollbar_bg: var(--grey7);
    --scrollbar_handle: #294A60;
    --scrollbar_hover: #367B94;
    --scrollbar_down: var(--cyber_cyan);
    --scrollbar_border: #294A60;
    --palette_link: var(--cyber_cyan);
    --palette_linkVisited: var(--cyber_violet);
}

/* ========================================================================== */
/* Frames and dock headers: restrained neon rails around dark work surfaces    */
/* ========================================================================== */

QMenuBar {
    border-bottom: 1px solid var(--cyber_line);
}

QMenuBar::item:selected {
    color: var(--cyber_ice);
    background: var(--blue5);
}

QMenu {
    border: 1px solid #367B94;
    border-radius: var(--border_radius);
}

QMenu::item:selected {
    background: #154459;
    color: var(--cyber_ice);
}

QToolTip {
    background: var(--grey8);
    color: var(--cyber_ice);
    border: 1px solid var(--cyber_cyan);
    padding: 5px 8px;
}

QDockWidget {
    color: var(--cyber_ice);
    font-family: 'JetBrainsMono Nerd Font', monospace;
    font-weight: bold;
}

QDockWidget::title {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #123047, stop: 1 #101726);
    border-top: 1px solid #2C6178;
    border-left: 3px solid var(--cyber_cyan);
    border-bottom: 1px solid var(--cyber_line);
    padding-left: 8px;
}

QDockWidget[objectName="PhxCast Chat_extraBrowser"]::title,
QDockWidget[objectName="PhxCast Stream Stats_extraBrowser"]::title,
QDockWidget#controlsDock::title {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 #2A1B37, stop: 1 #101726);
    border-left-color: var(--cyber_magenta);
    border-top-color: #68405F;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: var(--pink5);
}

QHeaderView::section {
    background: var(--grey5);
    color: var(--cyber_ice);
    border-color: var(--cyber_line);
}

QTabBar::tab:selected {
    color: var(--cyber_ice);
    border-color: var(--cyber_magenta);
    background: var(--tab_bg_down);
}

OBSBasicStatusBar {
    background: var(--grey8);
    border-top: 1px solid #22526A;
}

OBSQTDisplay {
    qproperty-displayBackgroundColor: var(--grey8);
}

/* ========================================================================== */
/* Controls: cyan broadcast, magenta recording, clear active-state colors      */
/* ========================================================================== */

#streamButton,
#broadcastButton {
    background: #103346;
    border-color: #00A6C1;
    color: var(--cyber_ice);
    font-weight: bold;
}

#streamButton:hover,
#broadcastButton:hover {
    background: #174E63;
    border-color: var(--cyber_cyan);
}

#streamButton.state-active,
#broadcastButton.state-active {
    background: #17677C;
    border-color: var(--cyber_cyan);
    color: var(--white1);
}

#recordButton {
    background: #321A33;
    border-color: #A63A7C;
    color: var(--cyber_pink);
    font-weight: bold;
}

#recordButton:hover {
    background: #50213F;
    border-color: var(--cyber_magenta);
}

#recordButton.state-active,
#pauseRecordButton.state-active {
    background: var(--red4);
    border-color: var(--red2);
    color: var(--white1);
}

#recordButton:hover.state-active,
#pauseRecordButton:hover.state-active {
    background: var(--red3);
    border-color: var(--red1);
}

QPushButton:pressed,
QPushButton:pressed:hover {
    border-color: var(--cyber_magenta);
}

/* ========================================================================== */
/* Mixer: cyan faders with amber warning and red peak indicators               */
/* ========================================================================== */

QSlider::handle {
    background: var(--cyber_ice);
    border: 1px solid var(--cyber_cyan);
}

QSlider::handle:hover {
    background: var(--cyber_cyan);
}

QSlider::handle:pressed {
    background: var(--cyber_magenta);
    border-color: var(--cyber_pink);
}

VolumeMeter {
    qproperty-backgroundNominalColor: #103B46;
    qproperty-foregroundNominalColor: #00D0E4;
    qproperty-backgroundWarningColor: var(--yellow5);
    qproperty-foregroundWarningColor: var(--yellow2);
    qproperty-backgroundErrorColor: var(--red5);
    qproperty-foregroundErrorColor: var(--red2);
    qproperty-majorTickColor: var(--white5);
    qproperty-minorTickColor: var(--grey1);
}
